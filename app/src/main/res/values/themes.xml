    <style name="Theme.Clinic" parent="Base.Theme.Clinic" />

    <style name="Theme.Clinic.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.Clinic.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.Clinic.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>